GOVERNANCE_TENANT_ID=
ENABLE_GENERATED_FEATURES=false
ALLOW_SCHEMA_MIGRATION=0
ALLOW_DESTRUCTIVE_SEED=0
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
